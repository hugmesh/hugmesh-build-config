<?xml version="1.0" encoding="UTF-8"?>
<!--
  Snapdragon shared SpotBugs INCLUDE filter.

  CURATED, not kitchen-sink. SpotBugs ships hundreds of bug patterns; this filter
  narrows analysis reporting to ONLY the patterns that enforce the two
  convention items SpotBugs (+ FindSecBugs) owns:

    D. defensive copies / no representation exposure (CERT OBJ04/05-J)
         EI_EXPOSE_REP    - returning a reference to a mutable internal field
         EI_EXPOSE_REP2   - storing an externally-supplied mutable object directly
         MS_EXPOSE_REP    - a static method exposes a mutable static
         MS_MUTABLE_ARRAY      - a mutable static array (e.g. String[] config)
         MS_MUTABLE_COLLECTION - a mutable static collection
         MS_PKGPROTECT         - a static field that should be package-protected/final

    E. no mutable static state
         MS_SHOULD_BE_FINAL    - a static field that is never reassigned

  FindSecBugs reuses the same EI_EXPOSE_REP* / MS_* pattern names for its
  security-flavoured detectors (keys, tokens, byte[]), so listing the pattern
  names here is enough to surface both the core and FindSecBugs findings for
  these conventions.

  We INCLUDE-filter (rather than run everything and exclude) so the report is
  exactly the D/E signal and nothing else — no NPE/dead-store/i18n noise drowning
  the convention findings on first rollout.

  ROLLOUT: SpotBugs runs WARN-FIRST via snapdragon-parent
  (spotbugs-maven-plugin failOnError=false + the spotbugs:spotbugs reporting
  goal, NOT spotbugs:check). The known-pattern baseline lives in
  spotbugs-exclude.xml.
-->
<FindBugsFilter>

  <!-- D. Representation exposure on instance state. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Bug pattern="MS_EXPOSE_REP"/>
  </Match>

  <!-- D. Mutable static fields exposed / shared (arrays, collections). -->
  <Match>
    <Bug pattern="MS_MUTABLE_ARRAY"/>
  </Match>
  <Match>
    <Bug pattern="MS_MUTABLE_COLLECTION"/>
  </Match>
  <Match>
    <Bug pattern="MS_MUTABLE_COLLECTION_PKGPROTECT"/>
  </Match>
  <Match>
    <Bug pattern="MS_PKGPROTECT"/>
  </Match>

  <!-- E. Mutable static state that should be final. -->
  <Match>
    <Bug pattern="MS_SHOULD_BE_FINAL"/>
  </Match>
  <Match>
    <Bug pattern="MS_CANNOT_BE_FINAL"/>
  </Match>

</FindBugsFilter>
